# Application Settings
APP_NAME=NZ Construction Pricing Engine
ENV=development

# Backend Settings
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
API_PREFIX=/api

# Database
DATABASE_URL=sqlite:///./nz_pricing_engine.db

# File Upload Settings
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=52428800  # 50MB

# Required Excel Files
MASTER_WORKBOOK_NAME=Construction_Knowledge_Base_FINALIZED_WITH_SCHEMA.xlsm
BCM2_WORKBOOK_NAME=Building Costs m2 NZ.xlsm
ELEM_WORKBOOK_NAME=Elemental Costs of Building NZ.xlsm
CPR_WORKBOOK_NAME=CostPlan NZ Rates.xlsx
DET_WORKBOOK_NAME=Detailed Rates NZ.xlsm

# CORS Settings (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Frontend Settings
VITE_API_BASE_URL=http://localhost:8000/api
